<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="iem_church_management.FileUploaderCapture" t-inherit="web.FileUploader" t-inherit-mode="primary">
        <xpath expr="//input[@type='file']" position="attributes">
            <attribute name="capture">environment</attribute>
        </xpath>
    </t>
    <t t-name="iem_church_management.ChurchMemberImageField" t-inherit="web.ImageField" t-inherit-mode="primary">
        <xpath expr="//FileUploader" position="after">
            <CameraUploader acceptedFileExtensions="this.props.acceptedFileExtensions"
                            t-key="'camera_' + this.props.record.resId"
                            onUploaded.bind="this.onFileUploaded">
                <t t-set-slot="toggler">
                    <button type="button" class="btn btn-secondary o_btn_circle"
                            data-tooltip="Cámara" aria-label="Cámara">
                        <i class="fa fa-camera fa-fw"/>
                    </button>
                </t>
            </CameraUploader>
        </xpath>
    </t>
</templates>
