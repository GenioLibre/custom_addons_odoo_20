<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template for Subscription contracts report -->
    <template id="report_subscription_contracts" name="Subscription contracts details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="records">
                <t t-call="web.external_layout" o="records">
                    <div class="page">
                        <h2>
                            <t t-out='records.name'/>
                        </h2>
                        <table class="table table-striped">
                            <tr>
                                <th>Customer:</th>
                                <td>
                                    <t t-if="records.partner_id.name">
                                        <t t-out="records.partner_id.name"/>
                                    </t>
                                </td>
                                <th>Reference:</th>
                                <td>
                                    <t t-if="records.reference">
                                        <t t-out="records.reference"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <th>Recurring Period:</th>
                                <td>
                                    <t t-if="records.recurring_period">
                                        <t t-out="records.recurring_period"/>
                                        <t t-out="records.recurring_period_interval"/>
                                    </t>
                                </td>
                                <th>Company:</th>
                                <td>
                                    <t t-if="records.company_id">
                                        <t t-out="records.company_id.name"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <th>Start Date:</th>
                                <td>
                                    <t t-if="records.date_start">
                                        <t t-out="records.date_start"/>
                                    </t>
                                </td>
                                <th>End Date:</th>
                                <td>
                                    <t t-if="records.date_end">
                                        <t t-out="records.date_end"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <th>Stage:</th>
                                <td>
                                    <t t-if="records.state">
                                        <t t-out="records.state"/>
                                    </t>
                                </td>
                                <th>Date of Next Invoice:</th>
                                <td>
                                    <t t-if="records.next_invoice_date">
                                        <t t-out="records.next_invoice_date"/>
                                    </t>
                                </td>
                            </tr>
                        </table>
                        <h2>Contract Lines</h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Product</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Ordered Qty</th>
                                    <th scope="col">Unit Price</th>
                                    <th scope="col">Discount (%)</th>
                                    <th scope="col">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="records.contract_line_ids"
                                   t-as='res'>
                                    <tr>
                                        <td>
                                            <t t-out="res.product_id.name"/>
                                        </td>
                                        <td>
                                            <t t-out="res.description"/>
                                        </td>
                                        <td>
                                            <t t-out="res.qty_ordered"/>
                                            <t t-out='res.product_uom_id.name'/>
                                        </td>
                                        <td>
                                            <t t-out="res.price_unit"
                                               t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                        </td>
                                        <td>
                                            <t t-if="res.discount">
                                                <t t-out="res.discount"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-out="res.sub_total"
                                               t-options="{'widget': 'monetary', 'display_currency': res.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <h2>Sale Order Lines</h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Product</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Ordered Qty</th>
                                    <th scope="col">Unit Price</th>
                                    <th scope="col">Discount (%)</th>
                                    <th scope="col">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="records.sale_order_line_ids"
                                   t-as='rec'>
                                    <tr>
                                        <td>
                                            <t t-out="rec.product_id.name"/>
                                        </td>
                                        <td>
                                            <t t-out="rec.name"/>
                                        </td>
                                        <td>
                                            <t t-out="rec.product_uom_qty"/>
                                            <t t-out='rec.product_uom_id.name'/>
                                        </td>
                                        <td>
                                            <t t-out="rec.price_unit"
                                               t-options="{'widget': 'monetary', 'display_currency': rec.currency_id}"/>
                                        </td>
                                        <td>
                                            <t t-if="rec.discount">
                                                <t t-out="rec.discount"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-out="rec.price_subtotal"
                                               t-options="{'widget': 'monetary', 'display_currency': rec.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
