<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_tax_line" model="ir.ui.view">
        <field name="name">sale.order.form.tax.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/widget[@name='section_state']" position="before">
                <field name="price_tax" string="Impuesto" widget="monetary"
                       invisible="display_type or is_downpayment" optional="show"/>
                <field name="price_total_with_tax" string="Precio Total (c/IGV)"
                       invisible="display_type or is_downpayment" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
