        </record>
        <record id="group_project_task_user" model="res.groups">
            <field name="name">Tareas: Usuario</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_project_task"/>
        </record>
        <record id="group_project_task_admin" model="res.groups">
            <field name="name">Tareas: Administrador</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_project_task"/>
            <field name="implied_ids" eval="[Command.link(ref('group_project_task_user'))]"/>
        </record>
    </data>
</odoo>
