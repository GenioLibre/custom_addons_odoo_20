<odoo>
    <data noupdate="1">
        <record id="module_category_geniolibre" model="ir.module.category">
            <field name="name">GenioLibre</field>
            <field name="sequence">61</field>
        </record>
        <record id="privilege_project_task" model="res.groups.privilege">
            <field name="name">Tareas</field>
