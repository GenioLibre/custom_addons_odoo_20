<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hide_login_powered_by_odoo"
              inherit_id="web.login_layout"
              name="Hide login Powered by Odoo">
        <xpath expr="//a[contains(@href, 'www.odoo.com') and .//span[normalize-space()='Odoo']]"
               position="replace"/>
    </template>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.web.window.title.lite.odoo20</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="before">
                <div id="gl_branding_lite">
                    <block title="Branding" name="gl_branding_lite_settings">
                        <setting id="gl_web_window_title"
                                 string="Window Title"
                                 help="Título personalizado que aparecerá en la pestaña del navegador.">
                            <field name="web_window_title"
                                   placeholder="Shek Store"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
